# Exact hostnames, without a scheme or port. Localhost is always enabled.
DUCKPOND_ALLOWED_HOSTS=your-machine.your-tailnet.ts.net
# Optional project context for native tools, skills, and MCPs.
# DUCKPOND_AGENT_CWD=/home/you/code/project
# Optional absolute path to an installed Claude executable.
# DUCKPOND_CLAUDE_BIN=/home/you/.local/bin/claude
